@page
@model ProofTrail.Areas.Identity.Pages.Account.LoginModel
@{ ViewData["Title"] = "Log in"; }
<div class="auth-wrap"><div class="panel"><h3 class="mb-3">Log in</h3>
@if (Model.AdminSetupRequired) {
<div class="alert alert-info small">No Admin account exists yet. <a asp-page="SetupAdmin">Create the Admin account</a> (opens only on the computer running the app).</div>
}
<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" autocomplete="username" /></div>
<div class="mb-3"><label asp-for="Input.Password" class="form-label"></label><input asp-for="Input.Password" class="form-control" autocomplete="current-password" /></div>
<div class="form-check mb-3"><input asp-for="Input.RememberMe" class="form-check-input" /><label asp-for="Input.RememberMe" class="form-check-label"></label></div>
<button type="submit" class="btn btn-seal w-100">Log in</button></form>
<p class="mt-3 mb-0 small">No account? <a asp-page="Register">Sign up</a>. Verifiers do not need to log in: <a asp-area="" asp-controller="Verify" asp-action="Index">verify a credential</a>.</p>
</div></div>
