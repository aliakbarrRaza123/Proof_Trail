<li class="nav-item"><form asp-area="Identity" asp-page="/Account/Logout" method="post"><button class="nav-link btn btn-link" type="submit">Log out</button></form></li>
} else {
<li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Log in</a></li>
