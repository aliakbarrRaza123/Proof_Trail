@model List<AdminUserRow>
<div class="panel table-responsive">
    <table class="table">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Joined (UTC)</th></tr></thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr><td>@user.FullName</td><td>@user.Email</td><td>@user.RoleNames</td><td>@user.CreatedAt.ToString("dd MMM yyyy")</td></tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="4">No matching users.</td></tr>
        }
        </tbody>
    </table>
</div>
