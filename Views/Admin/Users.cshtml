@model List<AdminUserRow>
@{ ViewData["Title"] = "Users"; }

<h3 class="mb-3">Registered users</h3>
<form id="users-search" class="mb-3" method="get" asp-action="Users"
      data-search-url="@Url.Action("SearchUsers", "Admin")">
    <label class="form-label" for="search">Search by name or email</label>
    <div class="input-group">
        <input class="form-control" id="search" name="search" type="search" value="@ViewData["Search"]" maxlength="256" />
        <button class="btn btn-seal" type="submit">Search</button>
    </div>
</form>
<p id="users-search-message" class="text-danger" role="status" hidden></p>
<div id="users-results" aria-live="polite">
    <partial name="_UsersTable" model="Model" />
</div>

@section Scripts {
    <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/admin-users.js" asp-append-version="true"></script>
}
