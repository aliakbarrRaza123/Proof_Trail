@model HolderDashboardViewModel
@{ ViewData["Title"] = "Holder dashboard"; }
<h3 class="mb-3">Welcome, @Model.Account.FullName</h3>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="stat"><div class="n">@Model.Credentials.Count</div><div class="small text-muted">Credentials</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="n n-sm">@Model.Account.CreatedAt.ToString("dd MMM yyyy")</div><div class="small text-muted">Joined (UTC)</div></div></div>
    <div class="col-6 col-md-3"><div class="stat"><div class="n n-sm">Holder</div><div class="small text-muted">Account type</div></div></div>
</div>

<div class="panel mb-4">
    <h5 class="mb-3">My account</h5>
    <partial name="_AccountDetails" model="Model.Account" />
</div>

<div class="panel">
    <h5 class="mb-3">My certificates</h5>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Credential ID</th><th>Title</th><th>Issuer</th><th>Issued (UTC)</th></tr></thead>
            <tbody>
                @foreach (var credential in Model.Credentials)
                {
                    <tr>
                        <td><a asp-controller="Verify" asp-action="Index" asp-route-id="@credential.Id">@credential.Id</a></td>
                        <td>@credential.Title</td>
                        <td>@credential.InstitutionName</td>
                        <td>@credential.IssuedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
                @if (Model.Credentials.Count == 0)
                {
                    <tr><td colspan="4" class="text-muted">No credentials yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
