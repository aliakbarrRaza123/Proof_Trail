@model EditInstitutionInput
@{ ViewData["Title"] = "Edit institution profile"; }

<h3 class="mb-3">Edit institution profile</h3>
<div class="panel">
    <form asp-action="Edit" method="post">
        <div class="mb-3">
            <label asp-for="OfficialWebsite" class="form-label"></label>
            <input asp-for="OfficialWebsite" type="url" class="form-control"
                   placeholder="https://example.edu" maxlength="256" required />
            <span asp-validation-for="OfficialWebsite" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-seal">Save changes</button>
    </form>
</div>
