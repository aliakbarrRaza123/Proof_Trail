@model VerifyCredentialViewModel
@{ ViewData["Title"] = "Verify a credential"; }
<div class="container py-5" style="max-width:760px">
    <partial name="_BackLink" />
    <h2>Verify a credential</h2>
    <p>Enter a credential ID to look up its issuance record. No login needed.</p>
    <div class="panel">
        <form id="credential-lookup" method="get" asp-action="Index" asp-route-id=""
              data-lookup-url="@Url.Action("Lookup", "Verify", new { id = "" })">
            <label class="form-label" for="id">Credential ID</label>
            <div class="row g-2">
                <div class="col-sm-9">
                    <input id="id" name="id" class="form-control" value="@Model.Id" maxlength="36" required />
                </div>
                <div class="col-sm-3">
                    <button class="btn btn-seal w-100" type="submit">Verify</button>
                </div>
            </div>
        </form>
        <div id="credential-result" aria-live="polite">
            <partial name="_LookupResult" model="Model" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/credential-lookup.js" asp-append-version="true"></script>
}
