@{ ViewData["Title"] = "Home"; }
<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-md-7">
                <h1>Degrees and certificates that prove themselves.</h1>
                <p class="mt-3">
                    Institutions issue digitally signed credentials.
                    Employers check any credential in seconds with a QR code,
                    with no phone calls or emails to the university.
                </p>
                <a asp-controller="Verify" asp-action="Index" class="btn btn-seal btn-lg me-2 mt-2">Verify a credential</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg mt-2">Create an account</a>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <h2 class="mb-4">How it works</h2>
    <div class="row g-4">
        <div class="col-md-3"><div class="step"><h5>Issue</h5><p>The institution adds a student record or uploads a CSV file.</p></div></div>
        <div class="col-md-3"><div class="step"><h5>Sign</h5><p>The system hashes the record and signs it with the institution's key.</p></div></div>
        <div class="col-md-3"><div class="step"><h5>Share</h5><p>The student downloads a PDF certificate with a QR code.</p></div></div>
        <div class="col-md-3"><div class="step"><h5>Verify</h5><p>Anyone scans the QR code and sees Valid, Revoked, or Tampered.</p></div></div>
    </div>
</section>

<section class="container pb-5">
    <h2 class="mb-4">Who uses ProofTrail</h2>
    <div class="row g-3">
        <div class="col-md-3"><div class="panel h-100"><h5>Admin</h5><p class="mb-0">Approves institutions and audits the ledger.</p></div></div>
        <div class="col-md-3"><div class="panel h-100"><h5>Issuer</h5><p class="mb-0">Issues and revokes credentials.</p></div></div>
        <div class="col-md-3"><div class="panel h-100"><h5>Holder</h5><p class="mb-0">Downloads certificates and shares links.</p></div></div>
        <div class="col-md-3"><div class="panel h-100"><h5>Verifier</h5><p class="mb-0">Checks credentials without an account.</p></div></div>
    </div>
</section>
