@{ ViewData["Title"] = "Home"; }
<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-md-7">
                <h1>Degrees and certificates that prove themselves.</h1>
                <p class="mt-3">
                    Approved institutions issue credentials to registered holders.
                    Employers can look up the issuance record using its credential ID.
                </p>
                <a asp-controller="Verify" asp-action="Index" class="btn btn-seal btn-lg me-2 mt-2">Verify a credential</a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg mt-2">Create an account</a>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <h2 class="mb-4">How it works</h2>
    <div class="row g-4">
        <div class="col-md-3"><div class="step"><h5>Approve</h5><p>An Admin reviews the institution's registration.</p></div></div>
        <div class="col-md-3"><div class="step"><h5>Issue</h5><p>The institution issues a credential to the holder's registered email.</p></div></div>
        <div class="col-md-3"><div class="step"><h5>Share</h5><p>The holder finds the credential ID on their dashboard.</p></div></div>
        <div class="col-md-3"><div class="step"><h5>Look up</h5><p>Anyone with the credential ID can view its issuance record.</p></div></div>
    </div>
</section>

<section class="container pb-5">
    <h2 class="mb-4">Who uses ProofTrail</h2>
    <div class="row g-3">
        <div class="col-md-3"><div class="panel h-100"><h5>Admin</h5><p class="mb-0">Reviews institution registrations.</p></div></div>
        <div class="col-md-3"><div class="panel h-100"><h5>Issuer</h5><p class="mb-0">Issues credentials to registered holders.</p></div></div>
        <div class="col-md-3"><div class="panel h-100"><h5>Holder</h5><p class="mb-0">Views their own credentials and shares IDs.</p></div></div>
        <div class="col-md-3"><div class="panel h-100"><h5>Verifier</h5><p class="mb-0">Checks credentials without an account.</p></div></div>
    </div>
</section>
